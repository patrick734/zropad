# Chain (Zero mainnet values go here on launch day; Base Sepolia for testing)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
# Optional: where the site keeps its database (default ./zropad.db)
ZROPAD_DB=
NEXT_PUBLIC_EXPLORER=https://sepolia.basescan.org
# Contracts (from the deploy script's output)
NEXT_PUBLIC_ZROPAD=
NEXT_PUBLIC_ZRPD=
NEXT_PUBLIC_STAKING=
# The site's public address (for coin metadata links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: WalletConnect project ID (cloud.reown.com) for mobile wallets
NEXT_PUBLIC_WC_PROJECT_ID=
# Indexer: the block the hub was deployed at
START_BLOCK=0
